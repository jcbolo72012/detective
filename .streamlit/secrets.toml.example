# Copy these into Streamlit Community Cloud: App -> Settings -> Secrets.
# Top-level keys are exposed to the app as environment variables, which is how nl.py reads them.
# Never commit a real secrets.toml (it is in .gitignore).
ANTHROPIC_API_KEY = "sk-ant-..."
LLM_MODEL = "claude-haiku-5-5"
# Hard cap on AI calls per server process per day; after it the app falls back to keyword/template mode.
AI_DAILY_CAP = "300"
# Optional LSTM forecast service (see lstm_service/DEPLOY.md). Leave out to hide the forecast panel.
FORECAST_URL = "https://<id>.lambda-url.us-east-1.on.aws/"
FORECAST_TOKEN = "<same token you set on the Lambda>"
